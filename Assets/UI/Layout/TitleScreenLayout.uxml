<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement style="flex-grow: 1; background-color: rgb(0, 0, 0);">
        <ui:Label text="Game Title" name="" style="color: rgb(255, 255, 255); -unity-text-align: upper-center; font-size: 25px;"/>
        <ui:Button text="Start Game" enable-rich-text="false" selectable="true" name="StartButton" style="color: rgb(255, 255, 255); background-color: rgb(0, 0, 0); width: 20%; align-self: center;"/>
        <ui:Button text="Exit Game" name="ExitButton" style="background-color: rgb(0, 0, 0); align-self: center; width: 20%; color: rgb(255, 255, 255);"/>
        <ui:Foldout text="Dificulty" toggle-on-label-click="true" style="width: 25%; height: auto; position: relative; align-self: center; color: rgb(255, 255, 255); -unity-text-outline-color: rgb(255, 255, 255); background-color: rgb(0, 0, 0); translate: 0 0; align-items: stretch;"/>
    </ui:VisualElement>
</ui:UXML>
