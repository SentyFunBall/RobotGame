<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement picking-mode="Ignore" style="flex-grow: 1; align-self: auto; justify-content: center; align-content: center; -unity-background-image-tint-color: rgb(0, 0, 0);">
        <ui:Button text="Level 1" selectable="true" name="Lvl1Button" style="-unity-text-auto-size: none; visibility: visible; overflow: visible; align-self: center; align-content: center; align-items: center; justify-content: center; width: auto; color: rgb(255, 255, 255); background-color: rgb(0, 0, 0); -unity-background-scale-mode: stretch-to-fill; -unity-slice-type: sliced; border-left-color: rgb(135, 135, 135); border-right-color: rgb(135, 135, 135); border-top-color: rgb(135, 135, 135); border-bottom-color: rgb(135, 135, 135); flex-direction: column; flex-wrap: nowrap;"/>
        <ui:Button text="Level 2" selectable="true" name="Lvl2Button" style="-unity-text-auto-size: none; visibility: visible; overflow: visible; align-self: center; align-content: center; align-items: center; justify-content: center; width: auto; color: rgb(255, 255, 255); background-color: rgb(0, 0, 0); -unity-background-scale-mode: stretch-to-fill; -unity-slice-type: sliced; border-left-color: rgb(135, 135, 135); border-right-color: rgb(135, 135, 135); border-top-color: rgb(135, 135, 135); border-bottom-color: rgb(135, 135, 135); -unity-background-image-tint-color: rgb(0, 0, 0);"/>
